{
  "name": "@xantiagoma/dokploy-api",
  "version": "0.0.11",
  "description": "Typed HTTP client for the Dokploy tRPC API",
  "type": "module",
  "license": "MIT",
  "author": "Santiago Montoya <xantiagoma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xantiagoma/dokploy-deploy.git",
    "directory": "packages/api-client"
  },
  "keywords": [
    "dokploy",
    "api",
    "trpc",
    "client",
    "paas",
    "docker"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "coverage": "bun scripts/coverage.ts",
    "coverage:pulumi": "bun scripts/coverage.ts --pulumi",
    "coverage:full": "bun scripts/coverage.ts --full",
    "build": "tsdown",
    "check-types": "bunx --bun tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "ts-morph": "^28.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "openapi-fetch": "^0.17.0"
  }
}
