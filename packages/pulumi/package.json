{
  "name": "@xantiagoma/dokploy-pulumi",
  "version": "0.0.12",
  "description": "Pulumi dynamic provider for Dokploy — manage projects, compose services, and domains as code",
  "type": "module",
  "license": "MIT",
  "author": "Santiago Montoya <xantiagoma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xantiagoma/dokploy-deploy.git",
    "directory": "packages/pulumi"
  },
  "keywords": [
    "dokploy",
    "pulumi",
    "iac",
    "infrastructure",
    "docker",
    "compose"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "bunx --bun tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@pulumi/pulumi": "catalog:",
    "@xantiagoma/dokploy-api": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
